# livecode — environment. Copy to livecode.env (chmod 600), never commit the real file.
# The defaults below are the hosh.it box values: copying this file unchanged is enough. There is NO secret:
# rooms are capability links (anyone with the link edits), nothing else is stored.
# required:

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/livecode:v0.1.0'
APP_BIND='127.0.0.1:9134'

# --- app ---
# Behind Traefik: X-Forwarded-For is trustworthy only from the docker gateway / loopback.
APP_TRUSTED_PROXIES='127.0.0.0/8,::1/128,172.16.0.0/12'
# Public origin: browsers may open room WebSockets only from it.
APP_BASE_URL='https://code.hosh.it'
APP_LOG_LEVEL='info'

# --- limits (defaults shown; sized for the 512 MiB container and the box disk) ---
# LIVECODE_ROOM_TTL_DAYS='7'           # a room idle this long (nobody opened or edited it) is deleted
# LIVECODE_MAX_FILE_KB='128'           # characters per file (html, css, js) — the editor refuses more,
#                                      # the server cuts back anything beyond (keep the editor default: 128)
# LIVECODE_MAX_DOC_KB='640'            # encoded size of one room (3 files + edit history)
# LIVECODE_MAX_ROOMS='2000'            # rooms on disk; new rooms refused beyond it
# LIVECODE_MAX_STORAGE_MB='512'        # bytes of all rooms on disk; new rooms refused beyond it
# LIVECODE_MAX_LIVE_ROOMS='100'        # rooms in memory at once
# LIVECODE_MAX_RSS_MB='384'            # process memory above which new rooms/connections wait
# LIVECODE_MAX_PEERS_PER_ROOM='32'
# LIVECODE_MAX_CONNS='500'             # WebSockets on the whole server
# LIVECODE_MAX_CONNS_PER_IP='24'
# LIVECODE_NEW_ROOMS_PER_HOUR='20'     # per client address
# LIVECODE_NEW_ROOMS_PER_HOUR_TOTAL='200'  # all addresses together (IPv6 rotation does not help)
